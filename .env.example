# ════════════════════════════════════════════════════════════════════════════
#  Automated Multi-Platform Posting System — Environment Variables
# ════════════════════════════════════════════════════════════════════════════
#
#  Copy this file to .env and fill in your credentials:
#
#    cp .env.example .env
#
#  NEVER commit your .env file to version control.
#  It is listed in .gitignore automatically when created.
#
#  Values marked [REQUIRED] must be set for that platform to work.
#  Values marked [OPTIONAL] have sensible defaults.
# ════════════════════════════════════════════════════════════════════════════


# ── 1. Pastebin ───────────────────────────────────────────────────────────────
# [REQUIRED] Your developer API key.
# How to get: Register at https://pastebin.com, then visit
#             https://pastebin.com/doc_api — the key is shown at the top.
PASTEBIN_API_KEY=your_pastebin_api_key_here


# ── 2. Telegram ───────────────────────────────────────────────────────────────
# [REQUIRED] Token given to you by @BotFather when you created your bot.
# How to get: Open Telegram → @BotFather → /newbot → follow prompts.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# [REQUIRED] The target channel or group.
# Format: @channel_username  (e.g. @mychannel)  — for public channels
#         or the numeric chat ID (e.g. -1001234567890) — for any chat
TELEGRAM_CHAT_ID=@your_channel_username

# [OPTIONAL] Public channel username WITHOUT the @ sign (e.g. mychannel).
# When set, the returned posted_url will be https://t.me/<username>/<msg_id>
# and public_access will be true.
# Leave empty if the channel is private — the URL will still be returned
# but public_access will be false.
TELEGRAM_CHANNEL_USERNAME=your_channel_username


# ── 3. Mastodon ───────────────────────────────────────────────────────────────
# [OPTIONAL] Domain of your Mastodon instance. Default: mastodon.social
# Do NOT include https:// — the app adds it automatically.
# Example: mastodon.social
MASTODON_INSTANCE=mastodon.social

# [REQUIRED] OAuth2 access token with write:statuses scope.
# How to get: Log in to your Mastodon instance →
#             Preferences → Development → New Application →
#             enable write:statuses → Submit → copy "Your access token".
MASTODON_ACCESS_TOKEN=your_mastodon_access_token_here


# ── 4. Reddit ─────────────────────────────────────────────────────────────────
# [REQUIRED] Client ID and secret from your Reddit script app.
# How to get: https://www.reddit.com/prefs/apps →
#             "create another app" → type: script → redirect URI: http://localhost
#             Client ID = short string below the app name.
#             Client Secret = the "secret" field.
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# [REQUIRED] Your Reddit account credentials (used for the password OAuth flow).
# IMPORTANT: 2FA (two-factor authentication) must be DISABLED on this account.
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# [REQUIRED] Subreddit to post in — without the r/ prefix.
# Use "test" for testing (r/test accepts posts from anyone).
REDDIT_SUBREDDIT=test


# ── 5. WordPress.com ──────────────────────────────────────────────────────────
# [REQUIRED] Your WordPress.com site domain — no https://, no trailing slash.
# Example: yoursite.wordpress.com
WORDPRESS_SITE=yoursite.wordpress.com

# [REQUIRED] OAuth2 bearer token.
# How to get:
#   1. Create an app at https://developer.wordpress.com/apps/
#   2. Set Redirect URL to http://localhost
#   3. Open this URL in your browser (replace YOUR_CLIENT_ID):
#      https://public-api.wordpress.com/oauth2/authorize?client_id=YOUR_CLIENT_ID&redirect_uri=http://localhost&response_type=token
#   4. Authorize. The browser redirects to:
#      http://localhost/#access_token=TOKEN_HERE&token_type=bearer&...
#   5. Copy the value after access_token= and paste it below.
WORDPRESS_TOKEN=your_wordpress_bearer_token_here
